              {
                "type": "null"
              }
            ],
            "title": "Temperature C"
          },
          "atmosphere": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "OXIDATION",
              "REDUCTION",
              "OTHER"
            ],
            "title": "Atmosphere",
            "default": "UNKNOWN"
          },
          "clay_body": {
            "type": "string",
            "maxLength": 160,
            "title": "Clay Body",
            "default": ""
